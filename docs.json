{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Itential",
  "colors": {
    "primary": "#1b93d2",
    "light": "#fe0094",
    "dark": "#fe0094"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "dark"
  },
  "background": {
