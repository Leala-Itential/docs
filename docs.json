      "family": "Roboto"
    },
    "body": {
      "family": "Open Sans"
    }
  },
  "navigation": {
    "versions": [
      {
        "version": "Itential Platform",
        "icon": "book",
        "tabs": [
          {
            "tab": "Home",
            "icon": "house",
            "pages": [
              "index"
            ]
          },
          {
            "tab": "Documentation",
            "icon": "book-open-lines",
            "groups": [
              {
                "group": "Itential Resources",
                "pages": [
                  "docs/itential-resources",
                  "docs/itential-product-documentation-new-faq",
                  "docs/itential-dependencies-consolidated",
                  "docs/isd-support-tickets-frequently-asked-questions",
                  "docs/accessibility-iap",
                  "docs/testing"
                ]
              },
              {
                "group": "Itential Developers (DevGuides)",
                "pages": [
                  "docs/adapter-api-routes-itential-platform",
                  "docs/adapter-degraded-status-itentil-platform",
                  "docs/broker-principal-config-setting-dev-2023-2",
                  "docs/enumerations-in-applications-itential-platform",
                  "docs/integration-api-routes"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "icon": "code",
            "openapi": "openapi.json"
          }
        ]
      },
      {
        "version": "Itential Opensource",
        "icon": "book",
        "tabs": [
          {
            "tab": "Home",
            "icon": "house",
            "pages": [
              "opensource"
            ]
          },
          {
            "tab": "Documentation",
            "icon": "book-open-lines",
