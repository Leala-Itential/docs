              {
                "group": "Adapters",
                "pages": [
                  "opensource/docs",
                  "opensource/docs/using-adapters-api-in-json-form-dropdowns",
                  {
                    "group": "Adapter Generic Methods",
                    "pages": [
                      "opensource/docs/adapter-generic-methods",
                      "opensource/docs/method-signatures",
                      "opensource/docs/iap-update-configuration"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "About Us",
          "href": "https://www.itential.com/company/about-us/",
          "icon": "users"
        },
        {
          "anchor": "FAQs",
          "href": "https://www.itential.com/faq/",
          "icon": "circle-question"
        },
        {
          "anchor": "Blog",
          "href": "https://www.itential.com/blog/",
          "icon": "newspaper"
        }
      ]
